# Where the NestJS API runs. Browser requests go through Next rewrites (/api/v1/*),
# so the API stays same-origin and its cookies are first-party.
API_URL=http://localhost:4000

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = never call the API; use the bundled sample data (handy for design work)
NEXT_PUBLIC_DEMO_MODE=false

# Extra image host for listing photos uploaded to S3/R2/MinIO
NEXT_PUBLIC_MEDIA_HOST=localhost
